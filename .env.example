# Public values only (safe for the browser). Never put the service role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://jeloegnvaxlfqjntbbyy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (ADR-0006) — SERVER-SIDE ONLY, never NEXT_PUBLIC_. Default: no provider (the product works without AI).
# AI_PROVIDER=none            # none | openrouter | deepseek | gemini (fixture: tests only). Vels/onboarding use AI only when set
# AI_TEXT_MODEL= AI_VISION_MODEL= AI_FALLBACK_PROVIDER= AI_FALLBACK_MODEL= AI_TIMEOUT_MS=15000 AI_REASONING=off
# DEEPSEEK_API_KEY=           # secret: set in Vercel, never commit
# GEMINI_API_KEY=             # secret: set in Vercel, never commit

# OpenRouter — SERVER-SIDE ONLY. Key in Vercel (Preview first) or .env.local, never in git.
# The key alone enables generic calls (/app/prueba-ia). Vels with account data also needs AI_PROVIDER=openrouter.
# OPENROUTER_MODEL must be openrouter/free, a ':free' model, or priced in AI_PRICES (else AI stays off).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Public URL sent to OpenRouter as attribution (HTTP-Referer). Empty → NEXT_PUBLIC_SITE_URL / Vercel URL.
APP_URL=
# AI_TEST_ENDPOINT=1          # enables /app/prueba-ia + POST /api/ai/chat on production (off there by default)

# Email Bridge (TASK-009) — SERVER-SIDE ONLY; POST /api/inbound/email answers 503 until both secrets exist.
# DATABASE_URL=               # privileged Postgres URL for webhook ingestion only (lib/server-db.ts)
# INBOUND_EMAIL_SECRET=       # HMAC secret shared with the inbound provider, >= 32 chars
# INGEST_EMAIL_DOMAIN=        # domain of the private forwarding addresses shown in Conexiones
