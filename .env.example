# Public values only (safe for the browser). Never put the service role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://jeloegnvaxlfqjntbbyy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (ADR-0006) — Gemini only. SERVER-SIDE ONLY: never NEXT_PUBLIC_. Without the key Vels still answers deterministically.
GEMINI_API_KEY=               # secret: Vercel env (Preview first) or .env.local, never commit
# GEMINI_MODEL=gemini-3.8-flash   # default in src/ai/config.ts (GEMINI_DEFAULT_MODEL)
# AI_PRICES={"gemini-3.8-flash":{"in":0,"out":0,"cached":0}}   # micro-USD per 1M tokens; unset → conservative ceiling
# AI_PROVIDER=none            # turn inference off (fixture: tests only)  AI_TIMEOUT_MS=15000  AI_REASONING=off
# AI_TEST_ENDPOINT=1          # enables /app/prueba-ia + POST /api/ai/chat on production (off there by default)

# Email Bridge (TASK-009) — SERVER-SIDE ONLY; POST /api/inbound/email answers 503 until both secrets exist.
# DATABASE_URL=               # privileged Postgres URL for webhook ingestion only (lib/server-db.ts)
# INBOUND_EMAIL_SECRET=       # HMAC secret shared with the inbound provider, >= 32 chars
# INGEST_EMAIL_DOMAIN=        # domain of the private forwarding addresses shown in Conexiones

# Public contact shown on /privacidad and /terminos (server-side read). Required before launch.
SUPPORT_EMAIL=
