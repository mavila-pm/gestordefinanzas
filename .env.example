# Public values only (safe for the browser). Never put the service role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://jeloegnvaxlfqjntbbyy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI (ADR-0015) — Gemini only. SERVER-SIDE ONLY: never NEXT_PUBLIC_. Without the key Vels still answers deterministically.
GEMINI_API_KEY=               # secret: Vercel env (Preview first) or .env.local, never commit
# GEMINI_MODEL=gemini-3.8-flash   # default in src/ai/config.ts (GEMINI_DEFAULT_MODEL)
# AI_PRICES={"gemini-3.8-flash":{"in":0,"out":0,"cached":0}}   # micro-USD per 1M tokens; unset → conservative ceiling
# AI_TIMEOUT_MS=15000  AI_REASONING=off|low|high  AI_MAX_INPUT_CHARS=6000  AI_MAX_OUTPUT_<OPERATION>   # optional limits
# AI_FIXTURE=1                # E2E only (scripts/e2e.sh): canned test answers instead of Gemini; ignored on any Vercel deployment

# Email Bridge (TASK-009) — SERVER-SIDE ONLY; POST /api/inbound/email answers 503 until both secrets exist.
# DATABASE_URL=               # privileged Postgres URL, server-only: webhook ingestion and billing (lib/server-db.ts)
# INBOUND_EMAIL_SECRET=       # HMAC secret shared with the inbound provider, >= 32 chars
# INGEST_EMAIL_DOMAIN=        # domain of the private forwarding addresses shown in Conexiones

# Cap anti-bot (ADR-0016) — SERVER-SIDE ONLY, never NEXT_PUBLIC_. Random, >= 32 chars (e.g. `openssl rand -base64 48`).
# Without it, login / signup / password recovery refuse every request (fail closed). Also needed for scripts/e2e.sh.
CAP_SECRET=

# Public contact shown on /privacidad and /terminos (server-side read). Required before launch.
SUPPORT_EMAIL=

# Culqi (billing, ADR-0018 + docs/runbooks/billing-culqi.md). Server-only env vars (the public key is handed to the page
# by the server; never NEXT_PUBLIC_). Test/live guard: outside Production only pk_test_/sk_test_ (sandbox, demo accounts
# only); VERCEL_ENV=production only pk_live_/sk_live_. Any mismatch → payments disabled with a logged reason.
# New card sales need CULQI_ENABLED=true; the webhook and "Cancelar renovación" need only valid keys + DATABASE_URL.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_ENABLED=false
# One Culqi plan id (pln_…) per plan + amount (minor units, = billing_price) + trial. The order amount picks the plan:
# from 2027-01-01 (Lima) the monthly price is 900 and needs its own plans; a missing plan = that purchase disabled.
CULQI_PLAN_MONTHLY_400_TRIAL=
CULQI_PLAN_MONTHLY_400=
CULQI_PLAN_MONTHLY_900_TRIAL=
CULQI_PLAN_MONTHLY_900=
CULQI_PLAN_ANNUAL_5900_TRIAL=
CULQI_PLAN_ANNUAL_5900=
# Webhook HTTP Basic credentials set in CulqiPanel (Eventos → Webhooks → Activar autenticación): user ≤ 20 chars,
# password ≥ 24 random chars. POST /api/billing/culqi answers 503 until these, the keys and DATABASE_URL exist.
CULQI_WEBHOOK_USER=
CULQI_WEBHOOK_PASSWORD=
